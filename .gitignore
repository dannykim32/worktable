node_modules/
dist/
# bundle/ is intentionally COMMITTED (not ignored): it is the runnable subset the
# Claude Code plugin loads, so the plugin must work after a plain `git clone`.
# `bun run bundle` rebuilds it from dist/; keep it in sync on every version bump.
.worktable/
.gstack/

# agent worktrees — never track
.claude/worktrees/

# local MCP registration (machine-specific abs path; recreate per docs/setup.md)
.mcp.json

# release tarballs (built artifacts)
dist-release/

# raw screen recordings — never commit; only rendered assets go in docs/media/
videos/

# macOS
.DS_Store
